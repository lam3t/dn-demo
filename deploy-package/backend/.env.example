# ========================================================
# TN EDU BACKEND CONFIGURATION FOR WINDOWS SERVER
# ========================================================

# Port chạy Backend Service
PORT=5000
NODE_ENV=production

# Kết nối CSDL PostgreSQL cài trên Windows Server (Mặc định: localhost:5432)
# Cú pháp: postgresql://[USER]:[PASSWORD]@localhost:5432/[DATABASE_NAME]?schema=public
DATABASE_URL="postgresql://postgres:YourSecurePassword123@localhost:5432/tn_edu?schema=public&connection_limit=20"
DIRECT_URL="postgresql://postgres:YourSecurePassword123@localhost:5432/tn_edu?schema=public"

# Bảo mật JWT Authentication (Nên đổi chuỗi ngẫu nhiên dài và bảo mật khi deploy)
JWT_SECRET="tn_edu_prod_secret_jwt_access_key_2026_change_me"
JWT_REFRESH_SECRET="tn_edu_prod_secret_jwt_refresh_key_2026_change_me"
JWT_ACCESS_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# CORS Origin: Địa chỉ IP hoặc Domain truy cập Frontend (VD: http://localhost, http://192.168.1.100, https://qlgd.school.edu.vn)
CORS_ORIGIN="http://localhost:80,http://127.0.0.1:80,http://localhost"
