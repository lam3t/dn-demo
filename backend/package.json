{
  "name": "tn-edu-backend",
  "version": "1.0.0",
  "description": "Backend API cho TN EDU - Quản lý Kế hoạch & Công việc Trường Phổ thông",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --exit-child src/index.ts",
    "build": "tsc && prisma generate",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "ts-node prisma/seed.ts",
    "db:seed:demo": "ts-node prisma/demo-scenario.ts",
    "prisma:studio": "prisma studio",
    "test:auth": "ts-node src/modules/auth/auth.test.ts",
    "test:users": "ts-node src/modules/users/users.test.ts",
    "test:plans": "ts-node src/modules/plans/plans.test.ts",
    "test:tasks": "ts-node src/modules/tasks/tasks.test.ts",
    "test:dashboard": "ts-node src/modules/dashboard/dashboard.test.ts",
    "test:admin": "ts-node src/modules/admin/admin.test.ts",
    "test:all": "npm run test:auth && npm run test:users && npm run test:plans && npm run test:tasks && npm run test:dashboard && npm run test:admin"
  },
  "keywords": [
    "education",
    "school-management",
    "express",
    "prisma"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "embedded-postgres": "^18.4.0-beta.17",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "@types/supertest": "^7.2.1",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
