datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

// --------------------------------------------------------
// ENUMS
// --------------------------------------------------------

enum Role {
  SYSTEM_ADMIN
  ADMIN
  HIEU_TRUONG
  PHO_HIEU_TRUONG
  TO_TRUONG
  GIAO_VIEN
  NHAN_VIEN
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PlanLevel {
  NAM
  HOC_KY
  QUY
  THANG
  TUAN
}

enum TaskStatus {
  NHAP
  DA_GIAO
  DA_TIEP_NHAN
  DANG_THUC_HIEN
  CHO_KIEM_TRA
  BO_SUNG
  HOAN_THANH
  XAC_NHAN
  DONG
  TAM_DUNG
  HUY
}

enum TaskPriority {
  THAP
  TRUNG_BINH
  CAO
  KHAN_CAP
}

enum TaskAssignmentRole {
  CHU_TRI
  PHOI_HOP
  KIEM_TRA
  PHE_DUYET
  THEO_DOI
}

enum NotificationType {
  GIAO_VIEC
  NHAC_VIEC
  CAN_BO_SUNG
  DA_HOAN_THANH
  HET_HAN
  HE_THONG
}

enum TaskEvaluationRating {
  XUAT_SAC
  TOT
  HOAN_THANH
  CHUA_DAT
}

enum AxisRoleScope {
  ALL
  GV_ONLY
  NV_ONLY
  RESTRICTED
}

// --------------------------------------------------------
// MULTI-TENANCY CORE MODELS (PLATFORM LAYER)
// --------------------------------------------------------

model Tenant {
  id            String       @id @default(uuid())
  code          String       @unique
  name          String
  status        TenantStatus @default(ACTIVE)
  logoUrl       String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  school          School?
  subscriptions   TenantSubscription[]
  systemAuditLogs SystemAuditLog[] @relation("TargetTenant")
  locations       Location[]
  orgUnits        OrgUnit[]
  users           User[]
  plans           Plan[]
  tasks           Task[]
  taskAssignments TaskAssignment[]
  taskLogs        TaskLog[]
  attachments     Attachment[]
  notifications   Notification[]
  comments        Comment[]
  adminAuditLogs  AdminAuditLog[]
  roles           RoleModel[]
  categories      SharedCategory[]
  kpiDefinitions  KPIDefinition[]
  kpiRecords      KPIRecord[]
  planLogs        PlanLog[]

  // Flexible KPI Module Relations
  evaluationPeriods       EvaluationPeriod[]
  kpiAxes                 KpiAxis[]
  unitAxisApplicabilities UnitAxisApplicability[]
  taskAssignmentLogs      TaskAssignmentLog[]
  kpiBonusProposals       KpiBonusProposal[]
  kpiScoreRecords         KpiScoreRecord[]
  kpiSpecialCases         KpiSpecialCase[]

  @@index([status])
  @@index([code])
}

model Package {
  id             String   @id @default(uuid())
  name           String
  code           String   @unique
  maxAccounts    Int      @default(100)
  storageQuotaGB Float    @default(20)
  enabledModules String?  // JSON string ví dụ: ["KPI", "REPORTS", "PLANS", "TASKS"]
  price          Float?   @default(0)
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscriptions  TenantSubscription[]

  @@index([code])
}

model TenantSubscription {
  id         String             @id @default(uuid())
  tenantId   String
  packageId  String
  startDate  DateTime           @default(now())
  endDate    DateTime
  status     SubscriptionStatus @default(ACTIVE)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  package    Package            @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([packageId])
  @@index([status])
}

model SystemAuditLog {
  id             String   @id @default(uuid())
  actorUserId    String
  action         String   // CREATE_TENANT, UPDATE_TENANT, SUSPEND_TENANT, ACTIVATE_TENANT, CREATE_PACKAGE, UPDATE_PACKAGE, CREATE_SUBSCRIPTION
  targetTenantId String?
  detail         String?
  ipAddress      String?
  createdAt      DateTime @default(now())

  actorUser      User     @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  targetTenant   Tenant?  @relation("TargetTenant", fields: [targetTenantId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([targetTenantId])
  @@index([createdAt])
}

// --------------------------------------------------------
// BUSINESS MODELS (TENANT-SCOPED)
// --------------------------------------------------------

model School {
  id                  String   @id @default(uuid())
  tenantId            String   @unique
  name                String
  code                String   @unique
  address             String?
  phone               String?
  email               String?
  website             String?
  principalName       String?  // Cô Phạm Thị Nam
  totalStudents       Int      @default(0)
  totalFemaleStudents Int      @default(0)
  totalClasses        Int      @default(0)
  totalStaff          Int      @default(0)
  schoolYear          String   @default("2026-2027")
  statsJson           String?  // JSON lưu phân bố sĩ số từng khối và điểm trường
  description         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locations Location[]
  orgUnits  OrgUnit[]
  users     User[]
  plans     Plan[]
  tasks     Task[]
}

model Location {
  id                 String   @id @default(uuid())
  tenantId           String
  schoolId           String
  name               String
  code               String
  address            String?
  phone              String?
  isMain             Boolean  @default(false)
  managerId          String?
  studentCount       Int?     @default(0)
  femaleStudentCount Int?     @default(0)
  classCount         Int?     @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  manager       User?          @relation("LocationManager", fields: [managerId], references: [id], onDelete: SetNull)
  users         User[]         @relation("PrimaryLocation")
  userRoles     UserRole[]     @relation("ScopedLocation")
  tasks         Task[]

  @@unique([schoolId, code])
  @@index([tenantId])
  @@index([tenantId, isMain])
  @@index([schoolId])
}

model OrgUnit {
  id          String    @id @default(uuid())
  tenantId    String
  schoolId    String
  name        String
  code        String
  parentId    String?
  orderIndex  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school      School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  parent      OrgUnit?   @relation("OrgHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    OrgUnit[]  @relation("OrgHierarchy")
  users       User[]     @relation("PrimaryOrgUnit")
  userRoles   UserRole[] @relation("ScopedOrgUnit")
  tasks       Task[]
  assignedTasks Task[]   @relation("TaskAssignedOrgUnit")

  // Flexible KPI Module Relations
  unitAxisApplicabilities UnitAxisApplicability[]
  taskAssignmentLogs      TaskAssignmentLog[]

  @@unique([schoolId, code])
  @@index([tenantId])
  @@index([tenantId, parentId])
  @@index([schoolId])
}

model User {
  id                String    @id @default(uuid())
  tenantId          String?
  email             String    @unique
  phone             String    @unique
  passwordHash      String
  fullName          String
  title             String?   // Chức vụ / môn giảng dạy chính
  avatarUrl         String?
  schoolId          String?
  primaryLocationId String?
  primaryOrgUnitId  String?
  isActive          Boolean   @default(true)
  isSystemAdmin     Boolean   @default(false)

  // Vị trí / Chức vụ mở rộng theo đặc thù trường học
  positionGroup          String?   // GV, NV, QL
  positionCode           String?   // gv_bo_mon, gvcn, ke_toan, thu_quy, van_thu, y_te, bao_ve, thu_vien, cntt, hieu_truong, pho_hieu_truong...
  isConcurrent           Boolean   @default(false)
  secondaryPositionCodes Json?     // e.g. ["gvcn", "cntt"]

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant            Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school            School?         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  primaryLocation   Location?       @relation("PrimaryLocation", fields: [primaryLocationId], references: [id], onDelete: SetNull)
  primaryOrgUnit    OrgUnit?        @relation("PrimaryOrgUnit", fields: [primaryOrgUnitId], references: [id], onDelete: SetNull)
  
  roles             UserRole[]
  createdPlans      Plan[]          @relation("PlanCreatedBy")
  createdTasks      Task[]          @relation("TaskCreatedBy")
  taskAssignments   TaskAssignment[]
  taskLogs          TaskLog[]
  planLogs          PlanLog[]
  proposedTasks     Task[]          @relation("TaskProposedBy")
  evaluatedTasks    Task[]          @relation("TaskEvaluatedBy")
  comments          Comment[]
  attachments       Attachment[]
  notifications     Notification[]
  managedLocations  Location[]      @relation("LocationManager")
  adminAuditLogs    AdminAuditLog[]
  systemAuditLogs   SystemAuditLog[]
  kpiRecords        KPIRecord[]

  // Flexible KPI Module Relations
  evaluationPeriodsCreated EvaluationPeriod[]  @relation("EvaluationPeriodCreatedBy")
  assignedLogs             TaskAssignmentLog[] @relation("AssignmentLogAssignedBy")
  receivedLogs             TaskAssignmentLog[] @relation("AssignmentLogAssignedTo")
  proposedBonuses          KpiBonusProposal[]  @relation("BonusProposedBy")
  approvedBonuses          KpiBonusProposal[]  @relation("BonusApprovedBy")
  kpiScoreRecords          KpiScoreRecord[]    @relation("KpiScoreEmployee")
  approvedKpiScores        KpiScoreRecord[]    @relation("KpiScoreApprovedBy")
  specialCases             KpiSpecialCase[]    @relation("SpecialCaseEmployee")
  approvedSpecialCases     KpiSpecialCase[]    @relation("SpecialCaseApprovedBy")

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, primaryLocationId])
  @@index([tenantId, primaryOrgUnitId])
  @@index([schoolId])
}

model UserRole {
  id              String     @id @default(uuid())
  tenantId        String?
  userId          String
  role            Role
  roleId          String?
  scopeLocationId String?
  scopeOrgUnitId  String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleModel       RoleModel? @relation(fields: [roleId], references: [id], onDelete: SetNull)
  scopeLocation   Location?  @relation("ScopedLocation", fields: [scopeLocationId], references: [id], onDelete: SetNull)
  scopeOrgUnit    OrgUnit?   @relation("ScopedOrgUnit", fields: [scopeOrgUnitId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([role])
  @@index([roleId])
  @@index([scopeLocationId])
  @@index([scopeOrgUnitId])
}

model Plan {
  id              String      @id @default(uuid())
  tenantId        String
  schoolId        String
  title           String
  description     String?
  level           PlanLevel
  parentPlanId    String?
  startDate       DateTime
  endDate         DateTime
  progressPercent Float       @default(0)
  createdById     String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school          School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  parentPlan      Plan?       @relation("PlanHierarchy", fields: [parentPlanId], references: [id], onDelete: SetNull)
  childrenPlans   Plan[]      @relation("PlanHierarchy")
  createdBy       User        @relation("PlanCreatedBy", fields: [createdById], references: [id])
  tasks           Task[]
  logs            PlanLog[]

  @@index([tenantId])
  @@index([tenantId, level])
  @@index([tenantId, startDate, endDate])
  @@index([schoolId])
  @@index([parentPlanId])
}

model PlanLog {
  id        String   @id @default(uuid())
  tenantId  String
  planId    String
  userId    String
  action    String   // TAO_MOI, CAP_NHAT, DIEU_CHINH_TIEN_DO, SAO_CHEP, XOA
  oldValues Json?
  newValues Json?
  note      String?
  createdAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, planId])
  @@index([planId])
  @@index([createdAt])
}

model Task {
  id                String                @id @default(uuid())
  tenantId          String
  schoolId          String
  code              String?
  title             String
  description       String?
  planId            String?
  locationId        String?
  orgUnitId         String?
  assignedOrgUnitId String?
  isOrgAssignment   Boolean               @default(false)
  priority          TaskPriority          @default(TRUNG_BINH)
  status            TaskStatus            @default(DA_GIAO)
  progressPercent   Int                   @default(0)
  requireAttachment Boolean               @default(false)
  startDate         DateTime?
  dueDate           DateTime?
  completedAt       DateTime?
  createdById       String

  // Đánh giá kết quả (TT 70, 89)
  evaluationRating  TaskEvaluationRating?
  evaluationComment String?
  evaluatedAt       DateTime?
  evaluatedById     String?

  // Đề xuất công việc (TT 77, 113)
  isProposal        Boolean               @default(false)
  proposalStatus    String?               // CHO_DUYET, DA_DUYET, TU_CHOI
  proposalNote      String?
  proposedById      String?

  // Bổ sung cho Module Đánh giá KPI theo Trục kết quả linh hoạt
  periodId          String?
  primaryAxisId     String?
  taskSubtype       String?               // gv_bo_mon, gvcn
  weightScore       Float?                @default(1.0) // Điểm trong thang 70
  evidenceFiles     Json?                 // Danh sách file minh chứng đính kèm
  warningFlags      Json?                 // Cảnh báo heuristic chống gian lận

  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school            School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  plan              Plan?                 @relation(fields: [planId], references: [id], onDelete: SetNull)
  location          Location?             @relation(fields: [locationId], references: [id], onDelete: SetNull)
  orgUnit           OrgUnit?              @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)
  assignedOrgUnit   OrgUnit?              @relation("TaskAssignedOrgUnit", fields: [assignedOrgUnitId], references: [id], onDelete: SetNull)
  createdBy         User                  @relation("TaskCreatedBy", fields: [createdById], references: [id])
  evaluatedBy       User?                 @relation("TaskEvaluatedBy", fields: [evaluatedById], references: [id], onDelete: SetNull)
  proposedBy        User?                 @relation("TaskProposedBy", fields: [proposedById], references: [id], onDelete: SetNull)

  // Flexible KPI Relations
  period            EvaluationPeriod?     @relation(fields: [periodId], references: [id], onDelete: SetNull)
  primaryAxis       KpiAxis?              @relation("TaskPrimaryAxis", fields: [primaryAxisId], references: [id], onDelete: SetNull)
  secondaryAxisTags KpiTaskAxisTag[]
  bonusProposals    KpiBonusProposal[]

  assignments       TaskAssignment[]
  logs              TaskLog[]
  attachments       Attachment[]
  comments          Comment[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@index([tenantId, planId])
  @@index([tenantId, locationId])
  @@index([tenantId, orgUnitId])
  @@index([tenantId, assignedOrgUnitId])
  @@index([tenantId, isProposal])
  @@index([tenantId, status, dueDate])
  @@index([schoolId])
  @@index([status])
  @@index([dueDate])
  @@index([createdById])
  @@index([createdAt])
  @@index([periodId])
  @@index([primaryAxisId])
}

model TaskAssignment {
  id          String              @id @default(uuid())
  tenantId    String
  taskId      String
  userId      String
  role        TaskAssignmentRole
  note        String?
  assignedAt  DateTime            @default(now())

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  task        Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId, role])
  @@index([tenantId])
  @@index([tenantId, taskId])
  @@index([tenantId, userId])
  @@index([taskId])
  @@index([userId])
}

model TaskLog {
  id          String      @id @default(uuid())
  tenantId    String
  taskId      String
  userId      String
  action      String      // TAO_MOI, CAP_NHAT_TIEN_DO, NOP_MINH_CHUNG, YEU_CAU_BO_SUNG, KIEM_TRA_DAT, PHE_DUYET, DONG, ...
  oldStatus   TaskStatus?
  newStatus   TaskStatus?
  oldProgress Int?
  newProgress Int?
  oldValues   Json?
  newValues   Json?
  note        String?
  createdAt   DateTime    @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  task        Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@index([tenantId])
  @@index([tenantId, taskId])
  @@index([taskId])
  @@index([createdAt])
}

model Attachment {
  id           String    @id @default(uuid())
  tenantId     String
  taskId       String?
  taskLogId    String?
  uploadedById String
  fileName     String
  originalName String
  fileUrl      String
  fileSize     Int
  mimeType     String
  createdAt    DateTime  @default(now())

  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  task         Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskLog      TaskLog?  @relation(fields: [taskLogId], references: [id], onDelete: SetNull)
  uploadedBy   User      @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, taskId])
  @@index([taskId])
  @@index([taskLogId])
  @@index([uploadedById])
}

model Notification {
  id        String           @id @default(uuid())
  tenantId  String
  userId    String
  type      NotificationType @default(HE_THONG)
  title     String
  content   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, userId, isRead])
  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model Comment {
  id          String   @id @default(uuid())
  tenantId    String
  taskId      String
  userId      String
  content     String
  mentions    Json?
  attachments Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, taskId])
  @@index([taskId])
  @@index([createdAt])
}

model AdminAuditLog {
  id          String   @id @default(uuid())
  tenantId    String
  actorUserId String
  action      String   // CREATE_USER, UPDATE_USER, LOCK_USER, UNLOCK_USER, RESET_PASSWORD, DELETE_USER, ADD_USER_ROLE, REMOVE_USER_ROLE, UPDATE_LOCATION, DELETE_LOCATION
  targetType  String   // USER, ROLE, LOCATION
  targetId    String
  detail      String?
  createdAt   DateTime @default(now())

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorUser   User     @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, actorUserId])
  @@index([actorUserId])
  @@index([createdAt])
}

// --------------------------------------------------------
// DYNAMIC RBAC & SHARED CATEGORY MODELS (PHASE 2)
// --------------------------------------------------------

model Permission {
  id              String           @id @default(uuid())
  key             String           @unique
  name            String
  category        String           // KE_HOACH, CONG_VIEC, KPI, BAO_CAO, DANH_MUC_TO_CHUC, QUAN_TRI_HE_THONG
  description     String?
  createdAt       DateTime         @default(now())

  rolePermissions RolePermission[]

  @@index([category])
  @@index([key])
}

model RoleModel {
  id              String           @id @default(uuid())
  tenantId        String?
  code            String
  name            String
  description     String?
  isSystem        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@index([tenantId, code])
  @@index([tenantId])
  @@index([code])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())

  role         RoleModel  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model SharedCategory {
  id          String    @id @default(uuid())
  tenantId    String
  type        String    // NAM_HOC, HOC_KY, LOAI_DANH_GIA, CHUC_VU
  code        String
  name        String
  orderIndex  Int       @default(0)
  isDefault   Boolean   @default(false)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type, code])
  @@index([tenantId])
  @@index([tenantId, type])
}

model KPIDefinition {
  id               String    @id @default(uuid())
  tenantId         String
  code             String
  name             String
  description      String?
  unit             String    @default("Điểm")
  targetValue      Float?
  weight           Float?    @default(1.0)
  applicableRoles  String?   // JSON string: ["GIAO_VIEN", "TO_TRUONG"]
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
}

model KPIRecord {
  id                      String    @id @default(uuid())
  tenantId                String
  userId                  String
  periodType              String    // TUAN, THANG, QUY, HOC_KY, NAM_HOC
  periodKey               String    // e.g. "2026-09", "QUY_3", "HOC_KY_1"
  schoolYear              String    @default("2026-2027")
  totalTasks              Int       @default(0)
  completedBeforeDeadline Int       @default(0)
  completedOnTime         Int       @default(0)
  completedLate           Int       @default(0)
  uncompletedTasks        Int       @default(0)
  scoreA_Quantity         Float     @default(0)
  scoreB_Quality          Float     @default(0)
  scoreC_Timeline         Float     @default(0)
  scoreD_Leadership       Float     @default(0)
  finalScore              Float     @default(0)
  rating                  String    @default("HOAN_THANH") // XUAT_SAC, TOT, HOAN_THANH, CHUA_DAT
  taskDetails             Json?
  manualScores            Json?
  calculatedBy            String?   @default("SYSTEM")
  calculatedAt            DateTime  @default(now())
  isFinalized             Boolean   @default(false)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  tenant                  Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, periodKey])
  @@index([tenantId])
  @@index([tenantId, userId])
  @@index([tenantId, periodKey])
}

// --------------------------------------------------------
// FLEXIBLE RESULT AXIS KPI MODELS (CÔNG VĂN SỞ GD&ĐT TP.HCM)
// --------------------------------------------------------

model EvaluationPeriod {
  id                 String           @id @default(uuid())
  tenantId           String
  name               String           // "Quý III/2026", "Quý IV/2026"
  code               String           // "QUY_3_2026"
  startDate          DateTime
  endDate            DateTime
  submissionDeadline DateTime?
  status             String           @default("open") // draft, open, closed
  schoolYear         String           @default("2026-2027")
  createdById        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy          User?            @relation("EvaluationPeriodCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  unitApplicabilities UnitAxisApplicability[]
  tasks              Task[]
  assignmentLogs     TaskAssignmentLog[]
  bonusProposals     KpiBonusProposal[]
  kpiScores          KpiScoreRecord[]
  specialCases       KpiSpecialCase[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([status])
}

model KpiAxis {
  id                      String                  @id @default(uuid())
  tenantId                String?                 // null cho system templates hoặc tenant-specific
  code                    String                  // dang, chuyen_mon, phong_trao, hanh_chinh, chuyen_doi_so, antt, y_te, kttc, khac
  name                    String
  description             String?
  displayOrder            Int                     @default(0)
  isActive                Boolean                 @default(true)
  roleScope               AxisRoleScope           @default(ALL)
  restrictedPositionCodes Json?                   // JSON array: ["ke_toan", "thu_quy"]
  requiresSubtype         Boolean                 @default(false)
  subtypeOptions          Json?                   // JSON array: [{"code":"gv_bo_mon","name":"GV bộ môn"},{"code":"gvcn","name":"GVCN"}]
  warnOveruseThresholdPct Float?                  @default(20.0)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  tenant                  Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unitApplicabilities     UnitAxisApplicability[]
  primaryTasks            Task[]                  @relation("TaskPrimaryAxis")
  secondaryTaskTags       KpiTaskAxisTag[]
  assignmentLogs          TaskAssignmentLog[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([code])
}

model UnitAxisApplicability {
  id           String           @id @default(uuid())
  tenantId     String
  unitId       String           // OrgUnit ID
  periodId     String           // EvaluationPeriod ID
  axisId       String           // KpiAxis ID
  isApplicable Boolean          @default(true)
  reason       String?          // Bắt buộc nếu isApplicable = false
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orgUnit      OrgUnit          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  period       EvaluationPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  axis         KpiAxis          @relation(fields: [axisId], references: [id], onDelete: Cascade)

  @@unique([unitId, periodId, axisId])
  @@index([tenantId])
  @@index([unitId, periodId])
}

model KpiTaskAxisTag {
  id        String   @id @default(uuid())
  taskId    String
  axisId    String
  createdAt DateTime @default(now())

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  axis      KpiAxis  @relation(fields: [axisId], references: [id], onDelete: Cascade)

  @@unique([taskId, axisId])
  @@index([taskId])
  @@index([axisId])
}

model TaskAssignmentLog {
  id                 String           @id @default(uuid())
  tenantId           String
  unitId             String?
  periodId           String
  assignedById       String
  assignedToId       String?
  assignedDepartment String?
  title              String
  description        String?
  relatedAxisId      String?
  note               String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orgUnit            OrgUnit?         @relation(fields: [unitId], references: [id], onDelete: SetNull)
  period             EvaluationPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  assignedBy         User             @relation("AssignmentLogAssignedBy", fields: [assignedById], references: [id], onDelete: Cascade)
  assignedTo         User?            @relation("AssignmentLogAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  relatedAxis        KpiAxis?         @relation(fields: [relatedAxisId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([periodId])
  @@index([assignedById])
  @@index([assignedToId])
}

model KpiBonusProposal {
  id                   String           @id @default(uuid())
  tenantId             String
  taskId               String
  periodId             String
  proposedById         String
  reasonType           String           // tien_do_vuot, sang_kien_moi
  reasonDescription    String?
  proposedBonusPct     Float            @default(5.0)
  calculatedBonusScore Float            @default(0)
  status               String           @default("proposed") // proposed, approved, rejected
  approvedById         String?
  approvedAt           DateTime?
  reviewNote           String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  tenant               Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  task                 Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  period               EvaluationPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  proposedBy           User             @relation("BonusProposedBy", fields: [proposedById], references: [id], onDelete: Cascade)
  approvedBy           User?            @relation("BonusApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([taskId])
  @@index([periodId])
  @@index([status])
}

model KpiScoreRecord {
  id                   String           @id @default(uuid())
  tenantId             String
  employeeId           String
  periodId             String
  groupType            Int              @default(2) // 1: Quản lý, 2: Không lãnh đạo, 3: Lao động NQ 27/70
  scoreGeneral         Float            @default(0) // A. Tiêu chuẩn chung: 0-30 điểm
  scoreTask            Float            @default(0) // B. Kết quả nhiệm vụ: 0-70 điểm
  scoreBonusRaw        Float            @default(0) // Tổng thưởng đề xuất
  scoreBonusCapped     Float            @default(0) // min(raw, 7, 10% * (scoreGeneral + scoreTask))
  scoreFinal           Float            @default(0) // min(100, scoreGeneral + scoreTask + scoreBonusCapped)
  classification       String           @default("hoan_thanh") // xuat_sac, tot, hoan_thanh, khong_hoan_thanh
  meetsExtraConditions Boolean          @default(false)
  status               String           @default("draft") // draft, submitted, approved
  approvedById         String?
  approvedAt           DateTime?
  axisBreakdown        Json?            // Phân bổ điểm theo trục & subtype
  isCarriedForward     Boolean          @default(false)
  overrideReason       String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  tenant               Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee             User             @relation("KpiScoreEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  period               EvaluationPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  approvedBy           User?            @relation("KpiScoreApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, employeeId, periodId])
  @@index([tenantId])
  @@index([periodId])
  @@index([employeeId])
  @@index([classification])
}

model KpiSpecialCase {
  id           String           @id @default(uuid())
  tenantId     String
  employeeId   String
  periodId     String
  caseType     String           // new_appointment_lt_2m, transferred_lt_2m, training_gte_2m, sick_maternity_gte_2m, under_investigation, force_majeure
  resolution   String           // carried_to_next_period, use_old_unit_assessment, default_not_completed, exempt
  note         String?
  attachments  Json?
  approvedById String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee     User             @relation("SpecialCaseEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  period       EvaluationPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  approvedBy   User?            @relation("SpecialCaseApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([employeeId])
  @@index([periodId])
}
